# Preferred unified configuration
# Any OpenAI-compatible endpoint works. For a live demo, prefer a direct
# domestic endpoint with lower first-token latency; the third-party proxy may
# take tens of seconds per turn.
LLM_API_KEY=
LLM_BASE_URL=https://api.vveai.com/v1
LLM_MODEL=gpt-4o-mini

# Compatibility with existing configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.vveai.com/v1
OPENAI_MODEL=gpt-4o-mini

API_KEY=
API_BASE=https://api.vveai.com/v1

# Application branding
VITE_AGENT_NAME=Noname助手

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
# A shorter timeout keeps the demo responsive; the service degrades to a
# deterministic reply instead of hanging.
LLM_TIMEOUT_SECONDS=35

# Anonymous session persistence
SESSION_STORAGE=sqlite
SESSION_DATABASE_PATH=runtime/replay.sqlite3
SESSION_MAX_MESSAGES=40
SESSION_RETENTION_HOURS=24
SESSION_CLEANUP_INTERVAL_SECONDS=300
